{
  "manifest_version": 3,
  "name": "MajesticToolkit",
  "short_name": "MajesticToolkit",
  "description": "MajesticToolkit: XenForo, мониторинг серверов, публичные профили, документы и Google.",
  "version": "1.5.1",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "notifications",
    "unlimitedStorage"
  ],
  "optional_host_permissions": [
    "https://forum.majestic-rp.ru/*",
    "https://forum.russia.online/*",
    "https://www.youtube.com/*",
    "https://rutube.ru/*",
    "https://www.twitch.tv/*",
    "https://www.googleapis.com/*",
    "https://docs.googleapis.com/*",
    "https://sheets.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://api.majestic-files.com/*"
  ],
  "action": {
    "default_title": "MajesticToolkit",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "options_page": "ui/workspace.html",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "default_locale": "ru"
}
