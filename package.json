{
  "name": "majestictoolkit",
  "private": true,
  "version": "2.1.2",
  "type": "module",
  "description": "Автономное браузерное расширение: форум, жалобы, экономика, Law Codex и Government Tools и Document Studio Google Workspace и Productivity & UX",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:browser": "python3 tests/browser-e2e.py",
    "test:browser:agencies": "python3 tests/browser-agencies-203.py",
    "test:browser:judicial": "python3 tests/browser-judicial-204.py",
    "test:browser:cases": "python3 tests/browser-court-cases-205.py",
    "build": "node scripts/build.mjs",
    "prepare:chromium": "node scripts/prepare-install.mjs chromium",
    "prepare:safari": "node scripts/prepare-install.mjs safari",
    "package:release": "node scripts/package.mjs",
    "verify": "npm test && npm run build && node scripts/verify.mjs && npm run package:release && node scripts/check-release.mjs",
    "build-for-amo": "npm run build && node scripts/verify.mjs && npm run package:release && node scripts/check-release.mjs",
    "ai:gateway": "node ai-gateway/server.mjs",
    "test:browser:proceedings": "python3 tests/browser-judicial-proceedings-206.py",
    "test:browser:procedural": "python3 tests/browser-procedural-documents-207.py",
    "test:browser:evidence": "python3 tests/browser-judicial-evidence-208.py",
    "test:browser:decisions": "python3 tests/browser-judicial-decisions-209.py",
    "test:browser:economy": "python3 tests/browser-economy-workspace-211.py",
    "test:browser:marketplace": "python3 tests/browser-marketplace-212.py"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "license": "MPL-2.0"
}
